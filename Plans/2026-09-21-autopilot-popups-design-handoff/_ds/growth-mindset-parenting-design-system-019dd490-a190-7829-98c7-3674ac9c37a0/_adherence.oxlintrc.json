{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "reference/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Lora|Source Serif 4|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Lora, Source Serif 4, Inter, JetBrains Mono."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-deep",
      "--accent-soft",
      "--border-w",
      "--card-blush",
      "--card-clay",
      "--card-cream",
      "--card-ink",
      "--card-sage",
      "--gutter",
      "--ink",
      "--ink-charcoal",
      "--ink-mute",
      "--ink-soft",
      "--mono",
      "--paper",
      "--paper-2",
      "--paper-3",
      "--r-lg",
      "--r-md",
      "--r-pill",
      "--r-sm",
      "--r-xl",
      "--r-xs",
      "--rule",
      "--sans",
      "--serif-italic",
      "--serif-text",
      "--shadow-hover",
      "--shadow-soft",
      "--social-body",
      "--social-eyebrow",
      "--social-foot",
      "--social-gutter",
      "--social-h1",
      "--social-h2",
      "--social-hero",
      "--social-list",
      "--social-list-sub",
      "--social-logo-h",
